{
  "type": "module",
  "scripts": {
    "build": "node scripts/build",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint-fix": "eslint . --fix && stylelint '**/*.css' --fix",
    "lint-web-ext": "npm run --silent build && web-ext lint --source-dir dist/firefox",
    "start": "npm run --silent start-firefox-desktop",
    "start-chromium": "node scripts/build watch chromium",
    "start-edge": "node scripts/build watch edge",
    "start-firefox-desktop": "node scripts/build watch firefox-desktop",
    "start-firefox-android": "node scripts/build watch firefox-android",
    "test": "jest --verbose",
    "test-live": "jest --config jest.live.config.js --verbose --runInBand",
    "type-check": "tsc --noEmit",
    "test-browser": "node --test __tests__/browser/chromium.test.mjs",
    "test-coverage": "jest --coverage"
  },
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-modules-commonjs": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.8",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.10",
    "archiver": "^8.0.0",
    "babel-jest": "^30.5.2",
    "convert-svg-to-png": "^0.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsdoc": "^65.5.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "puppeteer": "^25.18.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "svgo": "^4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "babel-jest": {
      "babel-preset-current-node-syntax": {
        "@babel/core": "$@babel/core"
      }
    }
  },
  "allowScripts": {
    "puppeteer@25.18.1": true,
    "esbuild@0.28.2": true
  }
}
