{
  "manifest_version": 3,
  "name": "YouTube Subtitle Translator",
  "version": "1.0.4",
  "author": "R. N. West",
  "homepage_url": "https://github.com/rnwst/easy-languages-dict",
  "description": "Adds interactive source-language subtitles and English translations to non-English YouTube videos.",

  "icons": {
      "48": "icons/128.svg",
      "128": "icons/128.svg"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/isolated.js"],
      "run_at": "document_end",
      "css": ["content/styles.css"],
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "background": {
    "type": "module",
    "service_worker": "background/main.js"
  },

  "permissions": [
    "webNavigation",
    "storage"
  ],

  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://www.bing.com/translator",
    "https://www.bing.com/ttranslatev3?*",
    "https://oneshot-free.www.deepl.com/v1/translate"
  ],

  "web_accessible_resources": [],

  "minimum_chrome_version": "116",

  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "128.0"
    }
  }
}
